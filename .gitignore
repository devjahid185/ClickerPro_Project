# ── Secrets / signing — NEVER commit ─────────────────────────────
keystores/
*.jks
*.keystore
**/key.properties
**/.env
.env

# ── Backend ──────────────────────────────────────────────────────
backend/node_modules/
backend/.env
backend/dist/

# ── Flutter / Dart ───────────────────────────────────────────────
clicker_pro/.dart_tool/
clicker_pro/build/
clicker_pro/.flutter-plugins
clicker_pro/.flutter-plugins-dependencies
clicker_pro/android/.gradle/
clicker_pro/android/local.properties
clicker_pro/ios/Pods/

# ── OS / editor ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Firebase service-account key (server-side secret — never commit)
laravel_backend/storage/app/firebase/
firebase-adminsdk*.json

# local debug logs (adb logcat dumps — large, may contain device data)
_*_log.txt
_google_login_log.txt

# local debug screenshots & adb UI dumps (large, regenerated on demand)
_p0_*.png
_r_*.png
_s.png
_s_s.png
_set*.png
_t_*.png
clicker_pro/screen_*.png
clicker_pro/flutter_*.png
clicker_pro/flutter_*.log
clicker_pro/coverage_run.log
clicker_pro/_raw.png
clicker_pro/_drawer_raw.png
clicker_pro/_ui*.xml
clicker_pro/ui_dump.xml
clicker_pro/a.log

# local tool state (never commit — contains credentials/caches)
.jetro/
.cursor/
.claude/settings.local.json

# build artifacts — generated output, never commit (rebuild on the server)
*.zip
*.tar.gz
*.tgz
*.apk
*.aab
**/tsconfig.tsbuildinfo
web_app/.next/
admin_panel/.next/
