generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum Role {
  OWNER
  FREELANCER
  BOTH
  MANAGER
  ADMIN
}

// Subscription tier a user is on. FREE is the default for everyone today;
// PRO unlocks any feature an admin has flagged as paid.
enum Plan {
  FREE
  PRO
}

enum EventStatus {
  PENDING         
  CONFIRMED       
  IN_PROGRESS     
  SHOT_COMPLETE   
  DELIVERED       
  COMPLETED       
  CANCELLED       
}

enum StatusChangeType {
  CREATED
  CONFIRMED
  STARTED
  SHOT_DONE
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Shift {
  DAY
  NIGHT
  BOTH
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
}

enum WaitlistStatus {
  WAITING
  CONTACTED
  BOOKED
  EXPIRED
}

enum PaymentKind {
  ADVANCE
  DUE
  EXTRA
  PAYOUT
}

// --- Models ---

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  password            String
  fullName            String
  phone               String?
  whatsapp            String?
  role                Role              @default(FREELANCER)
  ownerId             String?           // Manager → তার Owner এর id
  plan                Plan              @default(FREE)
  planExpiresAt       DateTime?         // null = no expiry (e.g. lifetime/free)
  twoFactorEnabled    Boolean           @default(false)
  totpSecret          String?           // base32 TOTP secret (admin 2FA)
  language            String            @default("en")
  distributionOn      Boolean           @default(false) 
  logoUrl             String?
  signatureUrl        String?
  avatarUrl           String?
  bio                 String?
  specialization      String?
  bkash               String?
  vatBin              String?           
  bankDetails         Json?             
  managerPermissions  Json?             
  publicBookingToken  String?           @unique 
  vatEnabled          Boolean           @default(false)
  vatPercentage       Float             @default(15.00)
  notificationPrefs   Json              @default("{\"booking\":true,\"payment\":true,\"reedit\":true,\"announcement\":true,\"wish\":true}")
  businessName        String?
  businessAddress     String?
  // Account deletion 7-day grace (Req 8.1 / 8.2)
  deletedAt           DateTime?
  // Lifetime stats — Phase 2 এ aggregation worker এই গুলো update করবে
  totalEvents         Int               @default(0)
  totalRevenueMinor   Int               @default(0)
  totalClients        Int               @default(0)
  statsRefreshedAt    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  clients             Client[]          @relation("OwnerClients")
  events              Event[]           @relation("OwnerEvents")
  assignments         Assignment[]      @relation("AssignedStaff")
  memberships         TeamMembership[]  @relation("MemberOf")
  ownedTeam           TeamMembership[]  @relation("TeamOwner")
  expenses            Expense[]
  progress            TaskProgress[]    @relation("StaffProgress") 
  syncStatus          SyncStatus        @default(SYNCED)
  remoteRev           Int               @default(0)
  sentMessages        ChatMessage[]
  inviteCodes         TeamInviteCode[]
  waitlistEntries     Waitlist[]        @relation("OwnerWaitlist")
  reminders           Reminder[]        @relation("OwnerReminders")
  auditLogs           AuditLog[]        @relation("ActorAuditLogs")
}

// Team invite — Owner একটা 6-digit code generate করে, manager candidate সেটা
// দিয়ে account তৈরি করে, ownerId এ এই Owner-এর id বসে যায়।
model TeamInviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  role        Role      @default(MANAGER)
  expiresAt   DateTime
  consumedAt  DateTime?
  consumedBy  String?
  createdAt   DateTime  @default(now())

  @@index([ownerId])
}

// Email/phone OTP — signup, login, forgot password তিনটেতেই same টেবিল।
model OtpCode {
  id          String    @id @default(uuid())
  identifier  String    // email বা phone
  codeHash    String    // bcrypt-hashed 6-digit code
  purpose     String    // signup | login | forgotPassword
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([identifier, purpose])
}

// Password reset — verifyOtp এ পাঠানো token এই টেবিলে থাকে, reset endpoint
// সেটা match করে password update করে।
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Legal documents — Privacy / Terms দুটোরই row, language wise।  Admin
// content edit করতে পারবে; Flutter app version + body fetch করে।
model LegalDocument {
  id        String   @id @default(uuid())
  kind      String   // 'privacy' | 'terms'
  language  String   // 'en' | 'bn'
  version   String
  body      String
  updatedAt DateTime @updatedAt

  @@unique([kind, language])
}

model Client {
  id          String     @id @default(uuid())
  name        String
  email       String?
  phone       String
  address     String?
  dob         DateTime?
  anniversary DateTime?
  notes       String?
  ownerId     String
  owner       User       @relation("OwnerClients", fields: [ownerId], references: [id])
  events      Event[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  syncStatus  SyncStatus @default(SYNCED)
  remoteRev   Int        @default(0)
}

model Event {
  id                    String      @id @default(uuid())
  title                 String
  type                  String      
  date                  DateTime
  startTime             String?
  endTime               String?
  shift                 Shift       @default(DAY)
  venue                 String
  outdoor               Boolean     @default(false)
  status                EventStatus @default(PENDING)
  brideName             String?
  groomName             String?
  clientId              String
  client                Client      @relation(fields: [clientId], references: [id])
  ownerId               String
  owner                 User        @relation("OwnerEvents", fields: [ownerId], references: [id])
  creatorId             String?     
  packageId             String?
  package               Package?    @relation(fields: [packageId], references: [id])
  assignments           Assignment[]
  payments              Payment[]
  invoice               Invoice?
  expenses              Expense[]
  statusHistory         StatusHistory[]
  progress              TaskProgress[] 
  chiefId               String?     
  chiefHours            Int?
  hidePaymentFromTeam   Boolean     @default(false) 
  driveLink             String?
  clientRequirements    Json?       
  notes                 String?
  cancellationReason    String?
  cancelledAt           DateTime?
  cancelledBy           String?     
  statusUpdatedAt       DateTime    @default(now())
  statusUpdatedBy       String?     
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  syncStatus            SyncStatus  @default(SYNCED)
  remoteRev             Int         @default(0)
  extraHours            Float       @default(0)
}

model StatusHistory {
  id          String           @id @default(uuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromStatus  EventStatus?     
  toStatus    EventStatus      
  changeType  StatusChangeType
  changedBy   String           
  changedAt   DateTime         @default(now())
  note        String?          
  @@index([eventId])
}

model Assignment {
  id           String     @id @default(uuid())
  eventId      String
  userId       String
  event        Event      @relation(fields: [eventId], references: [id])
  user         User       @relation("AssignedStaff", fields: [userId], references: [id])
  role         String     
  payoutAmount Float      @default(0)
  payoutStatus String     @default("PENDING") 
  createdAt    DateTime   @default(now())
  syncStatus   SyncStatus @default(SYNCED)
  remoteRev    Int        @default(0)
}

model TeamMembership {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation("MemberOf", fields: [userId], references: [id])
  ownerId  String
  owner    User     @relation("TeamOwner", fields: [ownerId], references: [id])
  role     Role     @default(FREELANCER)
  joinedAt DateTime @default(now())
  @@unique([userId, ownerId])
}

model Package {
  id               String     @id @default(uuid())
  ownerId          String
  name             String
  description      String?
  price            Float
  coverageHours    Int        @default(0)
  extraHrRate      Float      @default(0)
  deliveryDays     Int        @default(0)
  printCount       Int?
  printSizes       Json?      
  videoIncluded    Boolean    @default(false)
  videoType        String?    
  videoDurationMin Int?
  includesDrone    Boolean    @default(false)
  includesAlbum    Boolean    @default(false)
  packageNotes     String?
  events           Event[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  syncStatus       SyncStatus @default(SYNCED)
  remoteRev        Int        @default(0)
}

model Payment {
  id            String      @id @default(uuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  amount        Float
  kind          PaymentKind @default(ADVANCE)
  method        String      
  transactionId String? 
  date          DateTime    @default(now())
  recipientId   String 
  payerId       String? 
  note          String?
  syncStatus    SyncStatus  @default(SYNCED)
  remoteRev     Int         @default(0)
}

model Invoice {
  id            String     @id @default(uuid())
  invoiceNumber String     @unique
  eventId       String     @unique
  event         Event      @relation(fields: [eventId], references: [id])
  subtotal      Float
  vatAmount     Float      @default(0)
  totalAmount   Float
  amountPaid    Float
  balanceDue    Float
  status        String     
  language      String     @default("en")
  pdfUrl        String?
  issuedAt      DateTime   @default(now())
  syncStatus    SyncStatus @default(SYNCED)
  remoteRev     Int        @default(0)
}

model GearItem {
  id         String     @id @default(uuid())
  ownerId    String
  name       String     
  category   String     
  serial     String?    
  condition  String?    
  value      Float?     
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  rentRecords RentRecord[] 
}

model RentRecord {
  id               String     @id @default(uuid())
  gearItemId       String?    
  gear             GearItem?  @relation(fields: [gearItemId], references: [id])
  direction        String     
  counterpartyName String     
  counterpartyPhone String?   
  amount           Float      @default(0) 
  dateLent        DateTime   @default(now()) 
  returnBy         DateTime?  
  actualReturnDate DateTime?  
  status           String     @default("ACTIVE") 
  ownerId          String     
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Notification {
  id       String   @id @default(uuid())
  userId   String
  category String   
  message  String
  read     Boolean  @default(false)
  sentAt   DateTime @default(now())
  deeplink String?
}

model ReEditRequest {
  id              String    @id @default(uuid())
  eventId         String
  requestedBy     String
  editorId        String
  deliverable     String    
  notes           String
  referenceImages Json?     
  round           Int       @default(1)
  status          String    @default("PENDING") 
  deadline        DateTime?
  createdAt       DateTime  @default(now())
}

model Expense {
  id         String     @id @default(uuid())
  amount     Float
  category   String
  date       DateTime   @default(now())
  eventId    String?
  event      Event?     @relation(fields: [eventId], references: [id])
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id])
  note       String?
  receiptUrl String?
  syncStatus SyncStatus @default(SYNCED)
  remoteRev  Int        @default(0)
}

// Prospective clients who couldn't be booked yet (date full, awaiting confirm).
model Waitlist {
  id            String         @id @default(uuid())
  ownerId       String
  owner         User           @relation("OwnerWaitlist", fields: [ownerId], references: [id])
  clientName    String
  phone         String
  preferredDate DateTime
  note          String?
  status        WaitlistStatus @default(WAITING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum ReminderType {
  PAYMENT
  DELIVERY
  FEEDBACK
}

enum ReminderChannel {
  WHATSAPP
  SMS
}

model Reminder {
  id            String          @id @default(uuid())
  ownerId       String
  owner         User            @relation("OwnerReminders", fields: [ownerId], references: [id])
  bookingId     String
  type          ReminderType    @default(PAYMENT)
  scheduledDate DateTime
  sent          Boolean         @default(false)
  channel       ReminderChannel @default(WHATSAPP)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Broadcast {
  id              String    @id @default(uuid())
  title           String
  content         String
  imageUrl        String?
  buttonLabel     String?
  link            String?
  type            String    
  priority        String    
  targetAudience  Json?     
  scheduleAt      DateTime?
  expiryAt        DateTime?
  displayDuration Int       @default(10)
  status          String    @default("DRAFT") 
  viewCount       Int       @default(0)
  clickCount      Int       @default(0)
  createdAt       DateTime  @default(now())
}

model TaskProgress {
  id          String   @id @default(uuid())
  eventId     String
  userId      String
  percentage Int      @default(0) 
  note        String?  
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation("StaffProgress", fields: [userId], references: [id])
  @@unique([eventId, userId]) 
}

model ChatGroup {
  id        String   @id @default(uuid())
  name      String   
  ownerId   String   
  createdAt DateTime @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  groupId   String
  senderId  String
  text      String
  sentAt    DateTime @default(now())
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])
}

// ✅ নতুন যোগ করা হয়েছে: সাপোর্ট টিকিট সিস্টেম
model SupportTicket {
  id          String   @id @default(uuid())
  userId      String   
  subject     String   
  message     String   
  priority    String   @default("NORMAL") 
  status      String   @default("OPEN")    
  screenshot  String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ✅ নতুন যোগ করা হয়েছে: FAQ সিস্টেম
model FAQ {
  id        String   @id @default(uuid())
  question  String   
  answer    String   
  category  String   
  order     Int      @default(0) 
  createdAt DateTime @default(now())
}

// Device tokens — FCM push registration table.  One user may have many
// devices (phone, tablet, web).  We dedupe on `(userId, token)` so a
// re-registration just bumps `lastSeenAt` instead of inserting a new
// row.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PERMISSION
}

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String
  actor       User        @relation("ActorAuditLogs", fields: [actorId], references: [id])
  actorName   String
  action      AuditAction
  entityType  String
  entityId    String
  entityLabel String?
  before      Json?
  after       Json?
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

model DeviceToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   // FCM registration token
  platform    String   // 'android' | 'ios' | 'web'
  appVersion  String?
  language    String?  // 'en' | 'bn' (helps backend localize push body)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

// Feature gating registry. One row per gateable feature. `requiresPro`
// controls whether FREE users can use it. Admins toggle this from the panel,
// so a feature can be made paid/free WITHOUT a code deploy. Today every flag
// is seeded with requiresPro = false (everything free).
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "reminders", "pdf_export", "waitlist"
  label       String           // human name shown in the admin panel
  description String?
  requiresPro Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Platform settings as a flat key→value store (one row per setting). Admin
// edits these from the Settings page; the app/server read them by key.
// Groups (general/smtp/gateway/social) are a UI convenience via the `group`
// column. Secret values (SMTP password, gateway keys) are write-only in the
// API response (masked on read).
model AppSetting {
  key       String   @id   // e.g. "app.name", "smtp.host", "social.facebook"
  value     String?
  group     String   @default("general")
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Discount / promo codes redeemable for a PRO subscription or a flat/percent
// off. Admin-created. `redeemedCount` tracks usage against `maxRedemptions`.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENT") // PERCENT | FLAT | PRO_DAYS
  discountValue  Int       @default(0)          // % , minor-currency, or days
  maxRedemptions Int?                            // null = unlimited
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

// Admin login / session activity for the device-history & suspicious-activity
// views. One row per login attempt (success or fail).
model LoginActivity {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  ip        String?
  userAgent String?
  success   Boolean  @default(false)
  reason    String?  // why it failed, if it did
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// IP blocklist — admin or the auto-throttle adds entries; auth rejects them.
model BlockedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())
}
