# Clicker Pro API — environment variables
# Copy to `.env` for local dev. On a host (Render/Railway/etc.) set these in
# the dashboard instead of committing them.

# PostgreSQL connection string (Prisma).
# Local example:
#   postgresql://postgres:postgres@localhost:5432/clicker_pro?schema=public
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — the server defaults to these if unset.
# PORT=5000
# HOST=0.0.0.0
# NODE_ENV=production
