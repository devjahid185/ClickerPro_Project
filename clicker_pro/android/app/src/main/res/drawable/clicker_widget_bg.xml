<?xml version="1.0" encoding="utf-8"?>
<!-- Home-widget card background — noir near-black with a soft border and
     rounded corners, matching the app's dark surface (#0C0E11). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0C0E11" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#2A2F38" />
</shape>
