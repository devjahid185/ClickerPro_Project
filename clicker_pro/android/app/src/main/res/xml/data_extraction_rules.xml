<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. We exclude the whole app so a fresh
  install on a NEW phone never inherits the previous device's saved login
  token (flutter_secure_storage) or preferences — every install starts
  logged-out, as expected.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
