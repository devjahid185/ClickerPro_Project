<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) launch theme — dark-mode variant. Identical to
     values-v31 so the OS SplashScreen icon is suppressed regardless of the
     device's light/dark setting; the launch window is black and hands off
     seamlessly to the Dart SplashScreen. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
